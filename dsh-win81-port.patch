Subject: [PATCH 01/14] =?UTF-8?q?win81-port:=20Desktop=20=E9=80=82?=
 =?UTF-8?q?=E9=85=8D=20Windows=208.1=EF=BC=88Electron=2022=20/=20Node=2022?=
 =?UTF-8?q?.19=20/=20rg=20=E5=9E=AB=E7=89=87=EF=BC=89?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- electron ^44.0.0 -> 22.3.27（Chromium 109，最后支持 Win7/8/8.1 的 Electron）
- 主进程 Node 16 缺失的 fetch 全局用 undici 5 垫齐（win81-compat.ts，上游版本 no-op）
- 内嵌运行时 node 24.21.0 -> 22.19.0（8.1 兼容构建，lock.json 含全平台 sha256）
- 终端面板：ConPTY 可用性预检，8.1 上给出可诊断错误（工具执行走 child_process，不受影响）
- 打包：DSH_WIN81=1 切换 win81 配置（产物名 -win81-x64，unsigned，自动取 Electron 22）
- rg.exe：构建后把 bcryptprimitives!ProcessPrng 导入重定向到 win81rng_shim.dll（转发 RtlGenRandom）
- CI：.github/workflows/build-win81.yml，产出 portable zip
---
 .github/workflows/build-win81.yml             |  48 ++++++++++++++++++
 apps/desktop/package.json                     |   3 +-
 .../desktop/resources/win81/win81rng_shim.dll | Bin 0 -> 44544 bytes
 .../scripts/electron-builder-config.win81.mjs |  19 +++++++
 apps/desktop/scripts/package-target.ts        |   3 +-
 apps/desktop/scripts/win81-patch-rg.mjs       |  40 +++++++++++++++
 apps/desktop/src/main.ts                      |   4 +-
 apps/desktop/src/win81-compat.ts              |  17 +++++++
 .../subprocess/subprocess-local/src/index.ts  |  16 +++++-
 scripts/primary-runtime/lock.json             |  14 ++---
 10 files changed, 152 insertions(+), 12 deletions(-)
 create mode 100644 .github/workflows/build-win81.yml
 create mode 100755 apps/desktop/resources/win81/win81rng_shim.dll
 create mode 100644 apps/desktop/scripts/electron-builder-config.win81.mjs
 create mode 100644 apps/desktop/scripts/win81-patch-rg.mjs
 create mode 100644 apps/desktop/src/win81-compat.ts

diff --git a/.github/workflows/build-win81.yml b/.github/workflows/build-win81.yml
new file mode 100644
index 0000000..225beb6
--- /dev/null
+++ b/.github/workflows/build-win81.yml
@@ -0,0 +1,48 @@
+name: build-win81
+
+on:
+  workflow_dispatch:
+  push:
+    branches: [win81-port]
+
+jobs:
+  build:
+    runs-on: windows-2022
+    env:
+      DSH_WIN81: '1'
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: pnpm/action-setup@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22.19.0
+          cache: pnpm
+
+      - name: Install dependencies
+        run: pnpm install --no-frozen-lockfile
+
+      - name: Build workspace
+        run: pnpm run build
+
+      - name: Package desktop (win x64, dir)
+        run: pnpm package:desktop:win:x64:dir
+
+      - name: Patch bundled ripgrep for Windows 8.1
+        shell: bash
+        run: |
+          DIR=$(find . -type d -name win-unpacked | head -1)
+          echo "win-unpacked: $DIR"
+          node apps/desktop/scripts/win81-patch-rg.mjs "$DIR"
+
+      - name: Package portable zip
+        shell: pwsh
+        run: |
+          $dir = Get-ChildItem -Recurse -Directory -Filter win-unpacked | Select-Object -First 1
+          Compress-Archive -Path (Join-Path $dir.FullName '*') -DestinationPath deepseek-harness-win81-x64-portable.zip
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: dsh-win81-portable
+          path: deepseek-harness-win81-x64-portable.zip
diff --git a/apps/desktop/package.json b/apps/desktop/package.json
index 3eaf57f..016c448 100644
--- a/apps/desktop/package.json
+++ b/apps/desktop/package.json
@@ -42,6 +42,7 @@
   },
   "dependencies": {
     "electron-updater": "^6.8.9",
+    "undici": "^5.28.5", // [win81-port] Electron 22 主进程 Node 16 无 fetch 全局，用 undici 5 垫
     "semver": "^7.8.5",
     "ws": "^8.21.0",
     "@deepseek-ai/dsh-api-gateway": "workspace:*",
@@ -60,7 +61,7 @@
     "@types/semver": "^7.8.0",
     "app-builder-lib": "26.15.3",
     "cos-nodejs-sdk-v5": "3.0.0",
-    "electron": "^44.0.0",
+    "electron": "22.3.27", // [win81-port] Chromium 109 = Win8.1 上限
     "electron-builder": "^26.15.3",
     "extract-zip": "^2.0.1",
     "js-yaml": "^4.2.0",

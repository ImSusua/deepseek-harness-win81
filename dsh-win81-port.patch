+// [win81-port] Electron 22 内嵌 Node 16.17，跑不动 pnpm 11（要求 Node >= 22.13）。
+// 改用 primary-runtime 内置的 Node（lock.json 已钉到 22.19.0）；尚未就绪时回退构建宿主 Node。
+const NODE = (() => {
+  const bundled = join(RUNTIME_ROOT, 'primary-runtime', 'dependencies', 'node', 'bin', process.platform === 'win32' ? 'node.exe' : 'node')
+  return existsSync(bundled) ? bundled : process.execPath
+})()

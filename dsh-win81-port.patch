diff --git a/apps/desktop/src/win81-compat.ts b/apps/desktop/src/win81-compat.ts
new file mode 100644
index 0000000..91b6d4f
--- /dev/null
+++ b/apps/desktop/src/win81-compat.ts
@@ -0,0 +1,17 @@
+/**
+ * [win81-port] Electron 22 (Chromium 109) 的主进程内嵌 Node 16，缺少 Node 18+ 的
+ * fetch / Headers / Response / Request 全局对象；web-document 的流式插件代理与
+ * main 的后端连接都依赖它们。这里用 undici 5（支持 Node 14+）补齐全局。
+ * 在 Electron 25+（Node 18+，即上游默认版本）上为 no-op，零影响。
+ */
+import { fetch, Headers, Response, Request, FormData } from 'undici'
+
+const g = globalThis as unknown as Record<string, unknown>
+
+if (typeof g.fetch !== 'function') {
+  g.fetch = fetch
+  g.Headers = Headers
+  g.Response = Response
+  g.Request = Request
+  g.FormData = FormData
+}
diff --git a/packages/subprocess/subprocess-local/src/index.ts b/packages/subprocess/subprocess-local/src/index.ts
index 7b11f4f..3f743bb 100644
--- a/packages/subprocess/subprocess-local/src/index.ts
+++ b/packages/subprocess/subprocess-local/src/index.ts
@@ -10,7 +10,7 @@
 
 import { constants } from 'node:fs'
 import { access, stat } from 'node:fs/promises'
-import { userInfo } from 'node:os'
+import { release as osRelease, userInfo } from 'node:os'
 import { delimiter, extname, isAbsolute, resolve } from 'node:path'
 import type { Duplex } from 'node:stream'
 import { Context } from '@deepseek-ai/cordis'
@@ -281,6 +281,14 @@ export class LocalSubprocessRuntime extends SubprocessRuntime {
     }
     let scope: ReturnType<typeof prepareLinuxTerminalScope> | undefined
     let terminal: NodePty.IPty
+    if (process.platform === 'win32' && !isConptyAvailable()) {
+      // [win81-port] ConPTY（CreatePseudoConsole）自 Windows 10 1709 才内置；
+      // 在 Windows 8.1 上给出可诊断的失败，而不是 node-pty 的深层异常。
+      // 仅影响交互式终端面板；普通工具执行（child_process + Job 容器）不受影响。
+      throw new Error(
+        `subprocess-local: interactive terminals require ConPTY (Windows 10 1709+); host is ${osRelease()} [win81-port]`,
+      )
+    }
     try {
       scope = containmentMode === 'linux-scope'
         ? prepareLinuxTerminalScope(launch, { ...activity?.env ?? env, PWD: spec.cwd, TERM: spec.terminalType })
@@ -338,3 +346,9 @@ function environmentValue(env: NodeJS.ProcessEnv, name: 'PATH' | 'PATHEXT'): str
 }
 
 export default LocalSubprocessRuntime
+
+// [win81-port] ConPTY 可用性探测：Windows 10 1709 (build 16299) 起内置。
+function isConptyAvailable(): boolean {
+  const build = Number(osRelease().split('.')[2] ?? '0')
+  return Number.isFinite(build) && build >= 16299
+}

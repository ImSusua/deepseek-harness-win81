diff --git a/apps/desktop/scripts/win81-patch-rg.mjs b/apps/desktop/scripts/win81-patch-rg.mjs
new file mode 100644
index 0000000..13ad8ba
--- /dev/null
+++ b/apps/desktop/scripts/win81-patch-rg.mjs
@@ -0,0 +1,40 @@
+// [win81-port] 修复内置 ripgrep：rg.exe（Rust 1.78+ 构建）静态导入
+// bcryptprimitives!ProcessPrng（Windows 10 1809+ 才有），在 8.1 上加载即败。
+// 做法：把导入表里的 DLL 名字符串原位改写为 win81rng_shim.dll，并把垫片放到旁边。
+// 垫片导出同名 ProcessPrng，转发到 advapi32!SystemFunction036 (RtlGenRandom)。
+// 用法: node win81-patch-rg.mjs <扫描根目录，例如 dist/win-unpacked>
+import { readdirSync, readFileSync, writeFileSync, copyFileSync } from 'node:fs'
+import { join, dirname } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const OLD = Buffer.from('bcryptprimitives.dll\0', 'latin1')
+const NEW = Buffer.from('win81rng_shim.dll\0\0', 'latin1') // 同 20 字节槽位，含 NUL
+const SHIM = join(dirname(fileURLToPath(import.meta.url)), '..', 'resources', 'win81', 'win81rng_shim.dll')
+
+function walkRgExe(dir, out = []) {
+  for (const entry of readdirSync(dir, { withFileTypes: true })) {
+    const path = join(dir, entry.name)
+    if (entry.isDirectory()) walkRgExe(path, out)
+    else if (entry.name === 'rg.exe') out.push(path)
+  }
+  return out
+}
+
+const root = process.argv[2]
+if (!root) { console.error('usage: node win81-patch-rg.mjs <root>'); process.exit(1) }
+const targets = walkRgExe(root)
+if (targets.length === 0) console.warn('[win81-port] 未找到 rg.exe（运行时树可能尚未包含 ripgrep）')
+let patched = 0
+for (const exe of targets) {
+  const buf = readFileSync(exe)
+  if (buf.includes(NEW)) { console.log('[win81-port] 已补丁，跳过:', exe); continue }
+  const idx = buf.indexOf(OLD)
+  if (idx < 0) { console.log('[win81-port] 无 bcryptprimitives 导入，跳过:', exe); continue }
+  if (buf.indexOf(OLD, idx + 1) >= 0) throw new Error(`[win81-port] 多处命中，拒绝盲改: ${exe}`)
+  NEW.copy(buf, idx)
+  writeFileSync(exe, buf)
+  copyFileSync(SHIM, join(dirname(exe), 'win81rng_shim.dll'))
+  patched++
+  console.log('[win81-port] 已补丁:', exe)
+}
+console.log(`[win81-port] rg.exe 补丁完成: ${patched}/${targets.length}`)

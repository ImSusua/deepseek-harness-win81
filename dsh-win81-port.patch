diff --git a/apps/desktop/scripts/electron-builder-config.win81.mjs b/apps/desktop/scripts/electron-builder-config.win81.mjs
new file mode 100644
index 0000000..7e8de92
--- /dev/null
+++ b/apps/desktop/scripts/electron-builder-config.win81.mjs
@@ -0,0 +1,19 @@
+// [win81-port] Windows 8.1 (x64) 打包配置包装器。
+// 前置条件：本分支已将 apps/desktop 的 electron 钉到 22.3.27（Chromium 109，
+// 是最后支持 Windows 7/8/8.1 的 Electron 大版本），内嵌 Node 运行时钉到 22.19.0。
+// 用法（Windows 构建机 / CI）:
+//   DSH_WIN81=1 pnpm --filter @deepseek-ai/dsh-desktop run package:win:x64:dir
+//   node scripts/win81-patch-rg.mjs dist/win-unpacked/resources/runtime
+// 变化点：
+//   1) 产物名追加 -win81-x64；
+//   2) 移除 electronDist 预取，electron-builder 按 devDependencies 自动取 22.3.27；
+//   3) 关闭 differentialPackage（我们事后要修改 rg.exe，避免与块映射不一致）。
+import { createElectronBuilderConfig } from './electron-builder-config.mjs'
+
+export function createWin81ElectronBuilderConfig(env = process.env) {
+  const config = createElectronBuilderConfig({ ...env, DSH_DESKTOP_UNSIGNED: '1', DSH_WIN81: '1' })
+  config.artifactName = 'deepseek-harness-${version}-win81-x64.${ext}'
+  delete config.electronDist
+  config.nsis = { ...(config.nsis ?? {}), differentialPackage: false }
+  return config
+}
